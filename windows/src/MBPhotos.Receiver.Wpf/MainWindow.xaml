<Window x:Class="MBPhotos.Receiver.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MBPhotos.Receiver.Wpf"
        x:Name="RootWindow"
        Title="MB Photos"
        Width="1080" Height="760" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="NavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="ReceiverNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Page}" Value="{x:Static local:ReceiverShellPage.Receiver}">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LibraryNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Page}" Value="{x:Static local:ReceiverShellPage.Library}">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Page}" Value="{x:Static local:ReceiverShellPage.Settings}">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReceiverStatusPillStyle" TargetType="Border" BasedOn="{StaticResource StatusPillStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style x:Key="LibraryVariantButtonStyle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ModernFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="VariantBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="VariantBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="VariantBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="VariantBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="VariantBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryTimeFilterButtonStyle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ModernFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TimeFilterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TimeFilterBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TimeFilterBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TimeFilterBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="TimeFilterBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SetupTemplate">
            <Border Style="{StaticResource HeroCardStyle}" MaxWidth="650" Padding="54,50">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="76" Height="76" CornerRadius="24" Background="{DynamicResource AccentGradientBrush}"
                            Margin="0,0,0,26" Effect="{DynamicResource HeroShadow}">
                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="34"
                                   AutomationProperties.Name=""
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitleStyle}"
                               TextAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyTextStyle}"
                               MaxWidth="430" Margin="0,12,0,28" TextAlignment="Center" />
                    <Button Content="Choose where photos are saved" Style="{StaticResource PrimaryButtonStyle}"
                            Click="ChooseLibraryRoot_Click" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StartingTemplate">
            <Border Style="{StaticResource HeroCardStyle}" MaxWidth="650" Padding="54,50">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="23" Background="{DynamicResource AccentSoftBrush}"
                            Margin="0,0,0,26">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="31"
                                   AutomationProperties.Name=""
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitleStyle}" TextAlignment="Center" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyTextStyle}"
                               MaxWidth="430" Margin="0,12,0,28" TextAlignment="Center" />
                    <ProgressBar Width="300" Height="8" IsIndeterminate="True"
                                 Style="{StaticResource ModernProgressBarStyle}" />
                    <Button Content="Cancel" Style="{StaticResource QuietButtonStyle}"
                            Margin="0,22,0,0" Click="StopReceiving_Click" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReadyTemplate">
            <StackPanel MaxWidth="700">
                <Border Visibility="{Binding HasCompletionBanner, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="{Binding CompletionMessage}"
                        Margin="0,0,0,16" Padding="16" CornerRadius="18" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CompletionHasIssues}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource SurfaceElevatedBrush}"
                                ClipToBounds="True" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                                           AutomationProperties.Name=""
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding CompletionPreviewImage}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CompletionHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CompletionMessage}" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource HeroCardStyle}" Padding="44,36">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Style="{StaticResource ReceiverStatusPillStyle}" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SuccessBrush}"
                                           FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Heading}" Style="{StaticResource HeadingTextStyle}"
                                   TextAlignment="Center" MaxWidth="510" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource BodyTextStyle}"
                                   TextAlignment="Center" Margin="0,8,0,24" />
                        <Border Width="300" Height="300" Padding="15" CornerRadius="24"
                                Background="{DynamicResource QrBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Effect="{DynamicResource CardShadow}">
                            <Image Source="{Binding PairingQrImage}" Stretch="Uniform"
                                   AutomationProperties.Name="Pairing QR code" />
                        </Border>
                        <TextBlock Text="Open MB Photos and scan this code"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,18,0,8" />
                        <Button Content="Stop Receiving" Style="{StaticResource QuietButtonStyle}"
                                Click="StopReceiving_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ConnectedTemplate">
            <Border Style="{StaticResource HeroCardStyle}" MaxWidth="650" Padding="54,50">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="78" Height="78" CornerRadius="26" Background="{DynamicResource SuccessSoftBrush}"
                            Margin="0,0,0,24">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36"
                                   AutomationProperties.Name=""
                                   Foreground="{DynamicResource SuccessBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource StatusPillStyle}" Background="{DynamicResource SuccessSoftBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,18">
                        <TextBlock Text="Connected" Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitleStyle}" TextAlignment="Center" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyTextStyle}"
                               TextAlignment="Center" MaxWidth="430" Margin="0,12,0,28" />
                    <Button Content="Stop Receiving" Style="{StaticResource SecondaryButtonStyle}"
                            Click="StopReceiving_Click" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TransferringTemplate">
            <Border Style="{StaticResource HeroCardStyle}" MaxWidth="720" Padding="34">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Heading}" Style="{StaticResource HeadingTextStyle}" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource BodyTextStyle}" Margin="0,7,20,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}"
                                Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentBrush}"
                                       FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Height="330" Margin="0,26,0,24" CornerRadius="22"
                            Background="{DynamicResource SurfaceSecondaryBrush}" ClipToBounds="True">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="52"
                                           AutomationProperties.Name=""
                                           Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Your latest photo will appear here" Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                            <Image Source="{Binding TransferPreviewImage}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <ProgressBar Height="9" Minimum="0" Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                     Style="{StaticResource ModernProgressBarStyle}" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionTextStyle}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Row="3" Content="Stop Receiving" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,24,0,0" Click="StopReceiving_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FinalizingTemplate">
            <Border Style="{StaticResource HeroCardStyle}" MaxWidth="700" Padding="40">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Heading}" Style="{StaticResource HeadingTextStyle}" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource BodyTextStyle}" Margin="0,7,20,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}"
                                Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="Finalizing" Foreground="{DynamicResource AccentBrush}"
                                       FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Border Height="300" Margin="0,26,0,24" CornerRadius="22"
                            Background="{DynamicResource SurfaceSecondaryBrush}" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="52"
                                       AutomationProperties.Name=""
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding TransferPreviewImage}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <ProgressBar Height="9" IsIndeterminate="True" Style="{StaticResource ModernProgressBarStyle}" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionTextStyle}"
                               AutomationProperties.LiveSetting="Polite"
                               Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <Button Content="Stop Receiving" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,24,0,0" Click="StopReceiving_Click" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PausedTemplate">
            <Border Style="{StaticResource HeroCardStyle}" MaxWidth="650" Padding="54,50">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="74" Height="74" CornerRadius="24" Background="{DynamicResource SurfaceSecondaryBrush}"
                            Margin="0,0,0,24">
                        <TextBlock Text="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="33"
                                   AutomationProperties.Name=""
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitleStyle}" TextAlignment="Center" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyTextStyle}"
                               TextAlignment="Center" MaxWidth="430" Margin="0,12,0,28" />
                    <Button Content="Start Receiving" Style="{StaticResource PrimaryButtonStyle}"
                            Click="StartReceiving_Click" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ErrorTemplate">
            <Border Style="{StaticResource HeroCardStyle}" MaxWidth="680" Padding="44">
                <StackPanel>
                    <Border Width="66" Height="66" CornerRadius="22" Background="{DynamicResource ErrorSoftBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,22">
                        <TextBlock Text="&#xEA39;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30"
                                   AutomationProperties.Name=""
                                   Foreground="{DynamicResource ErrorBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitleStyle}" TextAlignment="Center" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyTextStyle}"
                               MaxWidth="480" Margin="0,12,0,28" TextAlignment="Center" />
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Try Again" Style="{StaticResource PrimaryButtonStyle}" Click="Retry_Click" />
                        <Button Content="Choose Another Folder" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="10,0,0,0" Click="ChooseLibraryRoot_Click" />
                    </WrapPanel>
                    <Expander Header="Details" Margin="0,24,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="14" Padding="16" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ErrorDetails}" FontFamily="Cascadia Mono, Consolas"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Margin="0,14,0,0" Style="{StaticResource CaptionTextStyle}"
                                           Text="If Windows Firewall asks, allow MB Photos on Private networks, then try again." />
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentGradientBrush}">
                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19"
                                   AutomationProperties.Name=""
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MB Photos" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Windows Receiver" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="14" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Receive" Style="{StaticResource ReceiverNavigationButtonStyle}"
                                Click="NavigateReceiver_Click" />
                        <Button x:Name="LibraryNavigationButton" Content="Library"
                                Style="{StaticResource LibraryNavigationButtonStyle}"
                                IsEnabled="{Binding CanOpenLibrary}" Click="NavigateLibrary_Click" />
                        <Button Content="Settings" Style="{StaticResource SettingsNavigationButtonStyle}"
                                Click="NavigateSettings_Click" />
                    </StackPanel>
                </Border>
                <Button x:Name="OverflowButton" Grid.Column="2" Content="&#xE712;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                        Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right"
                        AutomationProperties.Name="More options"
                        ToolTip="More options" Click="OverflowButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OverflowMenu"
                                     FontFamily="Segoe UI Variable Text, Segoe UI">
                            <MenuItem x:Name="CopyPairingLinkMenuItem" Header="Copy pairing link"
                                      Click="CopyPairingLink_Click" />
                            <Separator />
                            <MenuItem x:Name="OpenAnotherLibraryMenuItem" Header="Open another library…"
                                      Click="OpenAnotherLibrary_Click" />
                            <MenuItem Header="Open photos folder" Click="OpenPhotosFolder_Click" />
                            <Separator />
                            <MenuItem Header="Settings" Click="NavigateSettings_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid x:Name="ReceiverPage" ClipToBounds="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Page}" Value="{x:Static local:ReceiverShellPage.Receiver}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid Margin="32,30,32,38">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <ContentControl Content="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding StatusText}"
                                        AutomationProperties.LiveSetting="Polite">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SetupTemplate}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:ReceiverPresentationState.Starting}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource StartingTemplate}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:ReceiverPresentationState.Ready}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource ReadyTemplate}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:ReceiverPresentationState.Connected}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource ConnectedTemplate}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:ReceiverPresentationState.Transferring}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource TransferringTemplate}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:ReceiverPresentationState.Finalizing}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource FinalizingTemplate}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:ReceiverPresentationState.Paused}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource PausedTemplate}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:ReceiverPresentationState.Error}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource ErrorTemplate}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </Viewbox>
                </Grid>
            </Grid>

            <Grid x:Name="LibraryPage" ClipToBounds="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Page}" Value="{x:Static local:ReceiverShellPage.Library}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid Margin="30,24,30,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,2,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Your Library" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Name="LibrarySummaryText" Style="{StaticResource BodyTextStyle}" Margin="0,5,0,0" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="ReloadLibraryButton" Content="Refresh" Style="{StaticResource QuietButtonStyle}"
                                Click="ReloadLibrary_Click" />
                        <Button x:Name="OpenLibraryFolderButton" Content="Open Photos Folder"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                AutomationProperties.Name="Open master photos folder"
                                ToolTip="Open the master photos folder in File Explorer"
                                Click="OpenMasterFolder_Click" />
                        <Button x:Name="CloseLibraryButton" Content="Back to Receiver" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" Click="CloseLibrary_Click" />
                    </WrapPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="6*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel x:Name="LibraryTimeFilterPanel" Margin="2,0,2,6"
                                   Visibility="Collapsed"
                                   AutomationProperties.Name="Filter library by photo date">
                            <RadioButton x:Name="AllDatesFilterButton" Content="All" Tag="All"
                                         GroupName="LibraryTimeFilter" IsChecked="True"
                                         Style="{StaticResource LibraryTimeFilterButtonStyle}"
                                         Click="LibraryTimeFilter_Click" />
                            <RadioButton x:Name="TodayFilterButton" Content="Today" Tag="Today"
                                         GroupName="LibraryTimeFilter"
                                         Style="{StaticResource LibraryTimeFilterButtonStyle}"
                                         Click="LibraryTimeFilter_Click" />
                            <RadioButton x:Name="ThisWeekFilterButton" Content="This week" Tag="ThisWeek"
                                         GroupName="LibraryTimeFilter"
                                         Style="{StaticResource LibraryTimeFilterButtonStyle}"
                                         Click="LibraryTimeFilter_Click" />
                            <RadioButton x:Name="ThisMonthFilterButton" Content="This month" Tag="ThisMonth"
                                         GroupName="LibraryTimeFilter"
                                         Style="{StaticResource LibraryTimeFilterButtonStyle}"
                                         Click="LibraryTimeFilter_Click" />
                            <RadioButton x:Name="ThisYearFilterButton" Content="This year" Tag="ThisYear"
                                         GroupName="LibraryTimeFilter"
                                         Style="{StaticResource LibraryTimeFilterButtonStyle}"
                                         Click="LibraryTimeFilter_Click" />
                            <RadioButton x:Name="EarlierFilterButton" Content="Earlier" Tag="Earlier"
                                         GroupName="LibraryTimeFilter"
                                         Style="{StaticResource LibraryTimeFilterButtonStyle}"
                                         Click="LibraryTimeFilter_Click" />
                        </WrapPanel>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="7">
                        <ListBox x:Name="LibraryAssetList" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="LibraryAssetList_SelectionChanged"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="6" />
                                    <Setter Property="Margin" Value="2" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                        CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="98" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="88" Height="76" CornerRadius="12"
                                                Background="{DynamicResource SurfaceSecondaryBrush}" ClipToBounds="True"
                                                ContextMenuOpening="LibraryThumbnail_ContextMenuOpening">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Copy Full-Quality Image"
                                                              Click="CopyFullQualityImage_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                                                           AutomationProperties.Name=""
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <local:LazyThumbnailImage FilePath="{Binding ThumbnailPath}"
                                                                          DecodePixelWidth="240"
                                                                          Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                                            <TextBlock Text="{Binding Filename}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DateText}" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    </Grid>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18" ClipToBounds="True">
                            <Grid x:Name="LibraryDetailsLayout">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="LibraryPreviewContainer" Grid.Row="0" CornerRadius="18"
                                        Background="{DynamicResource SurfaceSecondaryBrush}" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="48"
                                                   AutomationProperties.Name=""
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="LibraryPreviewImage" Stretch="Uniform"
                                               StretchDirection="Both" />
                                        <MediaElement x:Name="LibraryPreviewVideo" Visibility="Collapsed"
                                                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                      Stretch="Uniform" IsMuted="True" Volume="0"
                                                      MediaOpened="LibraryPreviewVideo_MediaOpened"
                                                      MediaEnded="LibraryPreviewVideo_MediaEnded"
                                                      MediaFailed="LibraryPreviewVideo_MediaFailed" />
                                        <Border x:Name="LibraryPreviewMessageBorder" Visibility="Collapsed"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Padding="12,7" CornerRadius="10"
                                                Background="{DynamicResource SurfaceElevatedBrush}">
                                            <TextBlock x:Name="LibraryPreviewMessageText"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" Margin="4,10,4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="SaveLibraryPreviewButton" Visibility="Collapsed"
                                                Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                                                MinWidth="88" MinHeight="36" Padding="14,6" Margin="0"
                                                AutomationProperties.Name="Save selected version"
                                                Click="SaveLibraryPreview_Click" />
                                        <Button x:Name="CopyLibraryPreviewButton" Visibility="Collapsed"
                                                Content="Copy" Style="{StaticResource SecondaryButtonStyle}"
                                                MinWidth="88" MinHeight="36" Padding="14,6" Margin="8,0,0,0"
                                                AutomationProperties.Name="Copy selected full-quality image"
                                                ToolTip="Copy the selected full-quality image"
                                                Click="CopyLibraryPreview_Click" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                                    <TextBlock x:Name="LibraryFilenameText" FontSize="21" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="LibraryDateText" Style="{StaticResource BodyTextStyle}" Margin="0,5,0,0" />
                                    <TextBlock x:Name="LibraryFlagsText" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="13" Margin="0,5,0,0" />
                                    <TextBlock x:Name="LibraryArchiveText" Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel x:Name="VersionSelectionPanel" Grid.Row="3"
                                            Visibility="Collapsed" Margin="0,22,0,0">
                                    <TextBlock Text="Preview a version" FontSize="15" FontWeight="SemiBold" Margin="4,0,4,4" />
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="CurrentVersionButton" Content="Current Version" Tag="CurrentMaster"
                                                     GroupName="LibraryVersion" Style="{StaticResource LibraryVariantButtonStyle}"
                                                     Click="PreviewVariant_Click" />
                                        <RadioButton x:Name="OriginalVersionButton" Content="Original" Tag="RootOriginal"
                                                     GroupName="LibraryVersion" Style="{StaticResource LibraryVariantButtonStyle}"
                                                     Click="PreviewVariant_Click" />
                                        <RadioButton x:Name="CurrentMotionVersionButton" Content="Live Photo Video" Tag="CurrentLiveMotion"
                                                     GroupName="LibraryVersion" Style="{StaticResource LibraryVariantButtonStyle}"
                                                     Click="PreviewVariant_Click" />
                                        <RadioButton x:Name="OriginalMotionVersionButton" Content="Original Live Photo Video" Tag="OriginalLiveMotion"
                                                     GroupName="LibraryVersion" Style="{StaticResource LibraryVariantButtonStyle}"
                                                     Click="PreviewVariant_Click" />
                                    </UniformGrid>
                                    <StackPanel x:Name="AdditionalOriginalsPanel" Visibility="Collapsed" Margin="4,8,4,0">
                                        <TextBlock Text="Additional originals" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6" />
                                        <ComboBox x:Name="IndividualOriginalsComboBox" MinHeight="38" Padding="9,5"
                                                  VerticalContentAlignment="Center" DisplayMemberPath="Label"
                                                  SelectionChanged="IndividualOriginalsComboBox_SelectionChanged" />
                                    </StackPanel>
                                </StackPanel>
                                <Grid Grid.Row="4" Margin="4,17,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LibraryExportStatusText" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <Button x:Name="OpenMasterFolderButton" Grid.Column="1" Content="Open Photos Folder"
                                            Style="{StaticResource QuietButtonStyle}" Margin="12,0,0,0"
                                            Click="OpenMasterFolder_Click" />
                                </Grid>
                            </Grid>
                    </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsPage" ClipToBounds="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Page}" Value="{x:Static local:ReceiverShellPage.Settings}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid Margin="32,28,32,40">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <StackPanel Width="760" HorizontalAlignment="Center">
                    <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Library, support, and app information." Style="{StaticResource BodyTextStyle}" Margin="0,6,0,22" />
                    <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Photo library" Style="{StaticResource HeadingTextStyle}" />
                                <TextBlock Text="{Binding LibraryLocationText}" Style="{StaticResource BodyTextStyle}"
                                           Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Change Location" Style="{StaticResource SecondaryButtonStyle}"
                                    VerticalAlignment="Center" IsEnabled="{Binding CanChangeLibrary}"
                                    Click="ChooseLibraryRoot_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Support" Style="{StaticResource HeadingTextStyle}" />
                                <TextBlock Text="Create a redacted log if you need help troubleshooting a receiver problem."
                                           Style="{StaticResource BodyTextStyle}" Margin="0,7,0,0" />
                                <Expander Header="Connection help" Margin="0,14,0,0"
                                          Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}"
                                               Text="Keep both devices on the same private Wi-Fi network. If Windows asks, allow MB Photos on Private networks." />
                                </Expander>
                            </StackPanel>
                            <Button x:Name="ExportDiagnosticsButton" Grid.Column="1" Content="Export Diagnostics…"
                                    Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
                                    Click="ExportDiagnostics_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="About MB Photos" Style="{StaticResource HeadingTextStyle}" />
                            <TextBlock Text="A private, local way to keep an organized copy of your iPhone photo library on Windows."
                                       Style="{StaticResource BodyTextStyle}" Margin="0,7,0,0" />
                            <TextBlock x:Name="AppVersionText" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                        </StackPanel>
                    </Viewbox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
