<Window x:Class="MBPhotos.Receiver.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MB Photos"
        Width="1040" Height="780" MinWidth="800" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="MB Photos" FontSize="26" FontWeight="SemiBold" Foreground="#0F172A" />
            <TextBlock Text="Windows Library &amp; Receiver" FontSize="16" Foreground="#475569" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel x:Name="SelectPanel">
                <TextBlock Text="Receive from iPhone" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,20" Foreground="#475569"
                           Text="Choose the portable library root. The receiver creates a media-only Master folder and keeps originals, Live Photo motion, catalogs, and receiver state in MB Photos Data." />
                <DockPanel LastChildFill="True">
                    <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" />
                    <TextBox x:Name="DestinationTextBox" Height="40" Padding="10,8" VerticalContentAlignment="Center" />
                </DockPanel>
                <CheckBox x:Name="InitializeCheckBox" Margin="0,18,0,12"
                          Content="Initialize this folder if it is not already an MB Photos portable library" />
                <Button x:Name="StartButton" Content="Start receiver" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"
                        Foreground="White" FontWeight="SemiBold" Click="Start_Click" />
                <Border BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="Open an existing library" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,12" Foreground="#475569"
                                   Text="Browse the current catalog and export byte-exact current, original, or Live Photo motion files. Choose the library root, not Master by itself." />
                        <Button x:Name="OpenLibraryButton" Content="Open Library…" HorizontalAlignment="Left"
                                Click="OpenLibrary_Click" />
                    </StackPanel>
                </Border>
                <Border Background="#EFF6FF" CornerRadius="8" Padding="14" Margin="0,20,0,0">
                    <TextBlock Foreground="#1E3A8A"
                               Text="Both devices must be on the same private Wi-Fi network. Windows may ask you to allow private-network access the first time." />
                </Border>
            </StackPanel>

            <StackPanel x:Name="OperationPanel" Visibility="Collapsed">
                <TextBlock x:Name="OperationHeading" Text="Starting receiver" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="OperationSubtitle" Margin="0,8,0,22" Foreground="#475569"
                           Text="Preparing the secure local receiver…" />
                <ProgressBar Height="16" IsIndeterminate="True" />
                <Button x:Name="CancelOperationButton" Content="Cancel" Margin="0,20,0,0"
                        HorizontalAlignment="Left" Click="Stop_Click" />
            </StackPanel>

            <StackPanel x:Name="PairPanel" Visibility="Collapsed" HorizontalAlignment="Center" Width="540">
                <TextBlock Text="Scan with your iPhone" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="PairingSubtitle" Margin="0,7,0,14" Foreground="#475569" TextAlignment="Center" />
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14" CornerRadius="8" HorizontalAlignment="Center">
                    <Image x:Name="QrImage" Width="280" Height="280" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="PairingCodeText" FontFamily="Consolas" FontSize="11" Margin="0,12,0,4"
                           Foreground="#64748B" TextTrimming="CharacterEllipsis" ToolTip="Pairing payload" />
                <Button x:Name="PairStopButton" Content="Stop for now" HorizontalAlignment="Center" Click="Stop_Click" />
            </StackPanel>

            <StackPanel x:Name="TransferPanel" Visibility="Collapsed">
                <TextBlock x:Name="TransferHeading" Text="Receiving photos" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="TransferSubtitle" Margin="0,8,0,22" Foreground="#475569" />
                <ProgressBar x:Name="TransferProgress" Height="16" Minimum="0" Maximum="1" />
                <TextBlock x:Name="TransferCountText" Margin="0,10,0,2" FontWeight="SemiBold" />
                <TextBlock x:Name="TransferBytesText" Foreground="#64748B" />
                <TextBlock x:Name="CurrentFileText" Margin="0,12,0,2" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FreeSpaceText" Foreground="#64748B" />
                <TextBlock x:Name="TransferErrorText" Margin="0,12,0,0" Foreground="#B91C1C" FontWeight="SemiBold" />
                <Border Background="#FFFBEB" CornerRadius="8" Padding="14" Margin="0,20,0,16">
                    <TextBlock Foreground="#78350F"
                               Text="You may close this window or minimize it while the transfer continues in the notification area. Use Stop or Exit there to pause safely." />
                </Border>
                <Button x:Name="TransferStopButton" Content="Stop for now" HorizontalAlignment="Left" Click="Stop_Click" />
            </StackPanel>

            <StackPanel x:Name="CompletePanel" Visibility="Collapsed">
                <TextBlock Text="Sync complete" FontSize="24" FontWeight="SemiBold" Foreground="#166534" />
                <TextBlock x:Name="CompleteSubtitle" Margin="0,10,0,22" Foreground="#475569" />
                <WrapPanel>
                    <Button Content="Open library folder" Click="OpenFolder_Click" />
                    <Button Content="Receive another sync" Click="Restart_Click" />
                </WrapPanel>
            </StackPanel>

            <Grid x:Name="LibraryPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button x:Name="ReloadLibraryButton" Content="Reload" Click="ReloadLibrary_Click" />
                        <Button x:Name="CloseLibraryButton" Content="Close library" Click="CloseLibrary_Click" />
                    </WrapPanel>
                    <StackPanel>
                        <TextBlock Text="Portable Library" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="LibraryRootText" Margin="0,5,12,0" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LibrarySummaryText" Margin="0,3,12,0" Foreground="#64748B" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="340" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="3*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="White">
                        <ListBox x:Name="LibraryAssetList" BorderThickness="0" Padding="4"
                                 SelectionChanged="LibraryAssetList_SelectionChanged"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4" Width="Auto">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="68" Height="58" Background="#E2E8F0" CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,1,5,1">
                                            <TextBlock Text="{Binding Filename}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DateText}" Foreground="#64748B" FontSize="12" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="#475569" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="White" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Height="230" Background="#E2E8F0" CornerRadius="6" ClipToBounds="True">
                                <Image x:Name="LibraryPreviewImage" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock x:Name="LibraryFilenameText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="LibraryDateText" Margin="0,4,0,0" Foreground="#475569" />
                                <TextBlock x:Name="LibraryFlagsText" Margin="0,3,0,0" Foreground="#475569" />
                                <TextBlock x:Name="LibraryArchiveText" Margin="0,8,0,0" Foreground="#7C2D12" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Margin="0,16,0,8" Text="Exact-copy exports" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="3" VerticalAlignment="Top">
                                <WrapPanel>
                                    <Button x:Name="ExportCurrentButton" Content="Current Master" Tag="CurrentMaster" Click="ExportVariant_Click" />
                                    <Button x:Name="ExportOriginalButton" Content="Primary original" Tag="RootOriginal" Click="ExportVariant_Click" />
                                    <Button x:Name="ExportCurrentMotionButton" Content="Current Live MOV" Tag="CurrentLiveMotion" Click="ExportVariant_Click" />
                                    <Button x:Name="ExportOriginalMotionButton" Content="Original Live MOV" Tag="OriginalLiveMotion" Click="ExportVariant_Click" />
                                </WrapPanel>
                                <TextBlock Margin="0,12,0,5" Text="Individual untouched originals" Foreground="#475569" />
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="ExportIndividualOriginalButton" DockPanel.Dock="Right"
                                            Content="Export selected" Click="ExportIndividualOriginal_Click" />
                                    <ComboBox x:Name="IndividualOriginalsComboBox" Height="38" Padding="8,5"
                                              VerticalContentAlignment="Center" DisplayMemberPath="Label" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                                <TextBlock x:Name="LibraryExportStatusText" Foreground="#166534" />
                                <Button x:Name="OpenMasterFolderButton" Content="Open Master folder" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenMasterFolder_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                <TextBlock x:Name="ErrorHeading" Text="Receiver could not start" FontSize="22" FontWeight="SemiBold" Foreground="#991B1B" />
                <TextBlock x:Name="ErrorText" Margin="0,10,0,20" Foreground="#7F1D1D" />
                <Border Background="#FFF7ED" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <TextBlock Foreground="#7C2D12"
                               Text="If Windows Firewall blocked the connection, allow MBPhotosReceiver on Private networks only, then start the receiver again." />
                </Border>
                <Button Content="Back" HorizontalAlignment="Left" Click="Back_Click" />
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Portable library • Local transfer • No cloud service" Foreground="#64748B" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Export diagnostics…" MinWidth="150" Click="ExportDiagnostics_Click" />
        </DockPanel>
    </Grid>
</Window>
