<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111319" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1E27" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#222631" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#292E3A" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#252A35" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#303646" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F7FC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B6BDCC" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8E97A9" />
    <SolidColorBrush x:Key="BorderBrush" Color="#394050" />
    <SolidColorBrush x:Key="DividerBrush" Color="#303644" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5B8DEF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#73A0F5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4B7DDB" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#263759" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4B91F1" Offset="0" />
        <GradientStop Color="#796FF0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SuccessBrush" Color="#64D4A8" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#203E37" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F4B75D" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#49371E" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8794" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#4A2930" />
    <SolidColorBrush x:Key="FocusBrush" Color="#7AA7FF" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#71798A" />
    <SolidColorBrush x:Key="QrBackgroundBrush" Color="#FFFFFFFF" />
    <Color x:Key="ShadowColor">#65000000</Color>
</ResourceDictionary>
